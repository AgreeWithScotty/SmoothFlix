<?xml version="1.0" ?>
<settings version="1">
    <section id="plugin.video.smoothflix">
        <category id="account" label="32010" help="32011">
            <group id="1" label="32010">
                <setting id="email" type="string" label="32012" help="32013">
                    <level>0</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="password" type="string" label="32014" help="32015">
                    <level>0</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <hidden>true</hidden>
                    </control>
                </setting>
                <setting id="logout" type="action" label="32016" help="32017">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.smoothflix/logout)</data>
                    <control type="button" format="action"/>
                </setting>
            </group>
        </category>
