                        <minimum>0</minimum>
                        <step>5</step>
                        <maximum>1440</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="classic" type="boolean" label="32020" help="32021">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" format="boolean"/>
                </setting>
                <setting id="clear_cache" type="action" label="32005" help="32006">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.smoothflix/clear_cache)</data>
                    <control type="button" format="action"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
